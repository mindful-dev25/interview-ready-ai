APP_NAME="Interview Ready AI"
APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Sign in with Google. The OAuth client ID (ends in .apps.googleusercontent.com) from Google Cloud Console.
# When set, the app asks for a Google sign-in before it can be used. Leave empty for open access.
GOOGLE_CLIENT_ID=
# Signs the session cookie given out after a Google sign-in; use a random string of at least 32 characters.
# Left empty, a new one is made at startup, so everyone has to sign in again after each restart.
SESSION_SECRET=

CHROMA_PERSIST_DIR=./chroma_db
SESSION_STORE_PATH=./sessions
